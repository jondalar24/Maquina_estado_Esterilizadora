library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.std_logic_unsigned.all;

entity contadorMod6 is
	Port (	clk : in STD_LOGIC;
			reset_sinc : in STD_LOGIC;
			count : out STD_LOGIC_VECTOR(2 downto 0));
end contadorMod6;

architecture Behavioral of contadorMod6 is
signal count_int : STD_LOGIC_VECTOR(2 downto 0);
begin
	process(reset_sinc,clk)
	begin
		if clk'event and clk='1' then
			if reset_sinc='1' then
				count_int<="000";
			elsif count_int/="101" then --Tope de conteo
				count_int<= count_int+1;
			end if;
		end if;
	end process;
	count<=count_int;
end Behavioral;